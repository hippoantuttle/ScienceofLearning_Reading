# =============================================================
# .env.example — 환경변수 템플릿 (값 없음, 이 파일은 커밋됨)
# 실제 값은 로컬의 .env 에만 넣는다. .env 는 gitignore 되어 있음.
# 복사해서 사용: cp .env.example .env
# =============================================================

# ---- LLM (텍스트 난이도 분석 · 산출 후 피드백용) ----
# 사용하는 제공자에 맞게 해당 줄만 채운다. (제공자 확정 전에는 비워 둠)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_API_KEY=

# ---- 데이터베이스 (어휘·피드백·성찰일지 저장) ----
# Supabase 등 사용 시 채운다.
# SERVICE_ROLE 키는 서버 전용 — 클라이언트(확장·웹 프론트) 코드에 절대 넣지 말 것.
SUPABASE_URL=
# 신규 키 쌍 (서버 전용 secret은 절대 공유 금지)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# 아래는 레거시 키 쌍; 신규 키 쌍과 함께 사용하지 않는다.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 전용 합성 테스트 계정 정보: .env.supabase-test에 사용자 직접 입력, 채팅·저장소 공유 금지.
SUPABASE_TEST_EMAIL_A=
SUPABASE_TEST_PASSWORD_A=
SUPABASE_TEST_EMAIL_B=
SUPABASE_TEST_PASSWORD_B=
# C는 별도 비활성 테스트 계정 (참가자 계정 사용 금지)
SUPABASE_TEST_EMAIL_C=
SUPABASE_TEST_PASSWORD_C=

# ---- 세션/보안 ----
SESSION_SECRET=
# 로컬 테스트 중계 전용, 실제 서비스 인증 토큰이 아님
READING_LOCAL_TOKEN=

# ---- (선택) 배포 ----
# VERCEL_URL=
